# ─── Gateway ──────────────────────────────────────────────────────────────────
# Port the gateway listens on
GATEWAY_PORT=8080

# API key that the mobile app must send in the X-API-Key header
# Generate a secure random key: openssl rand -hex 32
GATEWAY_API_KEY=change_me_use_a_strong_random_key

# ─── OpenCode CLI ─────────────────────────────────────────────────────────────
# Path to the opencode binary (must be installed on the server)
OPENCODE_BIN=opencode

# Port that opencode will listen on (internal — not exposed externally)
OPENCODE_PORT=4096

# Hostname opencode binds to (internal only)
OPENCODE_HOSTNAME=127.0.0.1

# Password for the OpenCode server (same as OPENCODE_SERVER_PASSWORD in opencode)
OPENCODE_SERVER_PASSWORD=your_opencode_secret

# Project directory that opencode serve will use as working directory
# Leave empty to use the current directory
OPENCODE_PROJECT=/home/user/my-project

# Auto-start the opencode CLI when the gateway starts (true/false)
OPENCODE_AUTO_START=true
